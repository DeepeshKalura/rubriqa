# ---------------------------------------------------------------------------
# Exam Eval - local configuration example.
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- MiniMax LLM provider ---------------------------------------------------
# Accepts either MINIMAX_API_KEY or LLM_API_KEY (your existing key file uses
# LLM_API_KEY). The key is never logged and never sent to the browser.
MINIMAX_API_KEY=
LLM_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_VISION_MODEL=MiniMax-M3
MINIMAX_TIMEOUT_SECONDS=120
MINIMAX_MAX_RETRIES=3
MINIMAX_MAX_OUTPUT_TOKENS=4096
MINIMAX_DISABLE_THINKING=true

# --- Provider selection (feature flags) -------------------------------------
# llm_provider: minimax | fake
LLM_PROVIDER=minimax
# reader_mode: pdf_text | tesseract | minimax_vision | hybrid
READER_MODE=hybrid
# hybrid chain, executed in order. The first reader that clears
# HYBRID_ACCEPT_CONFIDENCE wins; anything below HYBRID_ESCALATE_BELOW is
# escalated to the next reader in the chain.
HYBRID_READER_CHAIN=pdf_text,tesseract,minimax_vision
HYBRID_ACCEPT_CONFIDENCE=0.75
HYBRID_ESCALATE_BELOW=0.60
TESSERACT_LANGS=eng+hin
TESSERACT_MIN_WORD_CONFIDENCE=45
LOW_CONFIDENCE_THRESHOLD=0.55
LOW_LEGIBILITY_THRESHOLD=0.6
VISION_MAX_IMAGE_SIDE=2200
REPAIR_ENABLED=true
REPAIR_AUTO_ACCEPT_MIN_LEGIBILITY=0.72
# scoring_strategy: hybrid | rubric_llm | exact | numeric
SCORING_STRATEGY=hybrid
SCORING_ENABLE_FEEDBACK=false

# --- Google Forms connector (feature flags) ---------------------------------
GOOGLE_FORMS_ENABLED=false
# google | mock
GOOGLE_FORMS_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8090/google/oauth/callback
# Used to encrypt stored OAuth refresh tokens at rest (Fernet key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=

# --- Jobs / worker ----------------------------------------------------------
WORKER_CONCURRENCY=2
OCR_THREADS=2
LLM_CONCURRENCY=3
JOB_HEARTBEAT_SECONDS=15
JOB_STUCK_MINUTES=10
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900
SWEEPER_INTERVAL_SECONDS=60
RETRY_BACKOFF_BASE_SECONDS=2

# --- Database (compose overrides host to service name) ----------------------
DATABASE_URL=postgresql+asyncpg://exameval:exameval@localhost:5435/exam_eval
RUN_MIGRATIONS=true

# --- Storage ----------------------------------------------------------------
STORAGE_ROOT=./data
MAX_UPLOAD_MB=50

# --- App ---------------------------------------------------------------------
APP_HOST=127.0.0.1
LOG_LEVEL=INFO
LOG_JSON=false
