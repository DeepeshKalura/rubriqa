# ---------------------------------------------------------------------------
# Entry Eval - local configuration example.
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- MiniMax LLM provider ---------------------------------------------------
# Accepts either MINIMAX_API_KEY or LLM_API_KEY. The key is never logged and
# never sent to the browser.
MINIMAX_API_KEY=
LLM_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_VISION_MODEL=MiniMax-M3
MINIMAX_TIMEOUT_SECONDS=120
MINIMAX_MAX_RETRIES=3
MINIMAX_MAX_OUTPUT_TOKENS=4096
MINIMAX_DISABLE_THINKING=true

# --- Provider selection (feature flags) -------------------------------------
# llm_provider: minimax | fake
LLM_PROVIDER=minimax
# reader_mode: pdf_text | tesseract | minimax_vision | hybrid
READER_MODE=hybrid
# hybrid chain, executed in order. The first reader that clears
# HYBRID_ACCEPT_CONFIDENCE wins; anything below HYBRID_ESCALATE_BELOW is
# flagged low_confidence and surfaced for human review.
HYBRID_READER_CHAIN=pdf_text,tesseract,minimax_vision
HYBRID_ACCEPT_CONFIDENCE=0.75
HYBRID_ESCALATE_BELOW=0.60
TESSERACT_LANGS=eng+hin
TESSERACT_MIN_WORD_CONFIDENCE=45
LOW_CONFIDENCE_THRESHOLD=0.55
VISION_MAX_IMAGE_SIDE=2200

# --- Google Drive (local mirror only; the only supported provider) ----------
# local = use ./data/drive_mirror as the Drive
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_PROVIDER=local
GOOGLE_DRIVE_LOCAL_ROOT=./data/drive_mirror

# --- Database (compose overrides host to service name) ----------------------
DATABASE_URL=postgresql+asyncpg://entryeval:entryeval@localhost:5435/entry_eval
RUN_MIGRATIONS=true

# --- Storage ----------------------------------------------------------------
STORAGE_ROOT=./data
MAX_UPLOAD_MB=50

# --- App ---------------------------------------------------------------------
APP_HOST=127.0.0.1
LOG_LEVEL=INFO
LOG_JSON=false

# --- Entry evaluation (the only flow) ---------------------------------------
EVAL_BATCH_SIZE=250
EVAL_BATCH_SIZE_MIN=200
EVAL_BATCH_SIZE_MAX=300
EVAL_REVIEW_SAMPLE_FRACTION=0.10
# rules = no-LLM cleaning (deterministic), llm = rules + LLM rewrite
CLEANING_MODE=rules
LLM_CONCURRENCY=3

# --- Sandbox (2-way OCR comparison) -----------------------------------------
# Default provider picked when the sandbox page first loads
SANDBOX_DEFAULT_PROVIDER=vision

# --- Auth (opt-in; default off — see roadmap item 2) -------------------------
# When AUTH_ENABLED=false (default) the app behaves exactly as before:
# no session cookie, no /auth routes enforced, every existing test passes.
# When AUTH_ENABLED=true, every router returns 403 until /auth/login succeeds.
# AUTH_ENABLED=false
# AUTH_ADMIN_USER=admin
# AUTH_ADMIN_PASSWORD_HASH=<bcrypt hash of the admin password>
# SESSION_SECRET=<a long random string — required when AUTH_ENABLED=true>
# Generate a bcrypt hash with:
#   docker compose run --rm web python -c "from app.auth import hash_password; print(hash_password('your-password-here'))"
#
# Production note: terminate TLS upstream (reverse proxy or load balancer).
# The session cookie is signed but not encrypted and uses httponly=False for
# dev convenience — exposing the app on plain HTTP leaks the signed cookie
# to any on-path observer. Set SESSION_SECRET to a fresh random value when
# enabling AUTH_ENABLED in production.
